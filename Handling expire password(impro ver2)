# $user가 없으면 계정 생성
# $user에 대해 administrator 권한 그룹 포함
# $user에 대한 만료 해제
# $user 패스워드 변경

# ===========================================================================================

$ErrorActionPreference = "Stop"

$User = "abc"
$PlainPassword = "abc계정 변경할 패스워드"

Write-Output "=== Local User Password Change Start ==="
Write-Output "Target User : $User"
Write-Output "Computer    : $env:COMPUTERNAME"
Write-Output "DateTime    : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"

try {

    # 1. 사용자 존재 여부 확인
    $LocalUser = Get-LocalUser -Name $User -ErrorAction SilentlyContinue

    if ($null -eq $LocalUser) {

        Write-Output "User check : NOT FOUND"
        Write-Output "Local user creation started."

        $SecurePassword = ConvertTo-SecureString $PlainPassword -AsPlainText -Force

        New-LocalUser `
            -Name $User `
            -Password $SecurePassword `
            -PasswordNeverExpires `
            -ErrorAction Stop

        Write-Output "Local user creation : OK"

        # Administrators 그룹 추가
        $AdministratorsGroup = Get-LocalGroup -SID "S-1-5-32-544"

        Add-LocalGroupMember `
            -Group $AdministratorsGroup.Name `
            -Member $User `
            -ErrorAction Stop

        Write-Output "Administrators group add : OK"

    }
    else {
        Write-Output "User check : EXISTS"
    }

    # 2. 패스워드 설정/변경
    $SecurePassword = ConvertTo-SecureString $PlainPassword -AsPlainText -Force

    Set-LocalUser `
        -Name $User `
        -Password $SecurePassword `
        -ErrorAction Stop

    Write-Output "Password change : OK"
    Write-Output "RESULT : SUCCESS"

}
catch {

    Write-Output "RESULT : FAILED"
    Write-Output "ERROR : $($_.Exception.Message)"
    Write-Output "TYPE : $($_.Exception.GetType().FullName)"

    exit 1
}
