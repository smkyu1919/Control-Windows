# 1차 시도)

# cmd
shutdown.exe /r /fw /t 0

# /r = 재부팅
# /fw = 다음 부팅을 Firmware UI, 즉 UEFI/BIOS 설정 화면으로 지정
# /t 0 = 즉시 재부팅


##########################################################################

# 2차 시도) 부팅 시, Bios 접근 버튼 눌러도 반응없을 경우, 부팅 후 관리자 CMD 수행

# cmd
reagentc /boottore shutdown /r /t 0



##########################################################################

# 논외) Windows 복구 메뉴로 들어가는 방법
# cmd
shutdown.exe /r /o /t 0
