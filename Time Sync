# Powershell
# 한국시간, KST로 변경
tzutil /s "Korea Standard Time"

# 사용 가능한 Time zone 목록 확인
tzutil /l

# 현재 timezone 확인
tzutil /g

# 동기화 상태 확인
w32tm /query /status

# 즉시 시간 재동기화
w32tm /resync

# 강제 재동기화
w32tm /resync /force

# Windows Time 서비스 재시작
sc query w32time

# Windows Time 서비스 중지
net stop w32time

# Windows Time 서비스 시작
net start w32time

# NTP 서버 지정 (windows time)
w32tm /config /manualpeerlist:"169.254.169.123" /syncfromflags:manual /reliable:no /update

# NTP 서버 지정 (AWS Time Sync Service)
w32tm /config /manualpeerlist:"169.254.169.123" /syncfromflags:manual /reliable:no /update
